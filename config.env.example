# Kline interval
KLINE_INTERVAL=5m

# Parquet archive directory (must be accessible to duckport-rs server)
PARQUET_DIR=$HOME/.duckport/data/pqt

# Data sources, comma-separated:
#   usdt_perp    USD-M perpetuals quoted in USDT        -> data.usdt_perp_<interval>
#   usdt_spot    spot pairs quoted in USDT              -> data.usdt_spot_<interval>
#   others_perp  USD-M perpetuals of every other quote  -> data.others_perp_<interval>
#                (USDC, USD1, U, BTC, ...). quote_volume is in each symbol's own quote
#                asset: ETHBTC is in BTC, not dollars. See data.exginfo.quote_asset.
# One instance takes either the usdt_* markets or others_perp, never both: install a
# second instance (duckport install binance-ingestor) for the other group.
DATA_SOURCES=usdt_perp,usdt_spot

# Concurrency (affects WS listener group count and fetch parallelism)
CONCURRENCY=2

# Keep each Arrow Flight data message below duckport-rs / tonic 64 MiB limit.
# Lower this if the server is configured with a smaller max decode message size.
DUCKPORT_APPEND_MAX_MESSAGE_BYTES=50331648

# Optional status timeout override for data.watermark.
# Default is max(900, KLINE_INTERVAL * 2) seconds.
# WATERMARK_MAX_LAG_SECONDS=1800

# Stream historical Parquet imports instead of loading a whole file into memory.
LOADHIST_BATCH_ROWS=50000
LOADHIST_DUCKDB_THREADS=1
# Optional DuckDB cap for small cloud servers, e.g. 1GB or 512MB.
# LOADHIST_DUCKDB_MEMORY_LIMIT=1GB

# Start date for historical data
START_DATE=2024-01-01

# Historical file download temporary directory
RESOURCE_PATH=$HOME/.duckport/data/hist

# HTTP proxy for Binance API (leave empty if not needed)
PROXY_URL=

# Enable WebSocket mode (true/false)
ENABLE_WS=false

# Instant remedy after a bar close (true/false). Default false: an incomplete
# websocket batch waits for the next complete bar's full remedy.
# When true, a close more than one bar behind duck_time goes straight to the full
# REST remedy. An adjacent close waits BATCH_REMEDY_WAIT_SEC; if the batch is
# still incomplete, missing symbols are fetched over REST and written only when
# the closed bar is complete.
# ENABLE_BATCH_REMEDY=false
# Seconds to wait for an adjacent bar's websocket batch. Default 8.
# BATCH_REMEDY_WAIT_SEC=8
